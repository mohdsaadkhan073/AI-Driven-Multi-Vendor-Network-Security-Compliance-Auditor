# EliteCore Network Security Compliance Auditor - Frontend Environment Variables
#
# LOCAL DEVELOPMENT:
# Leave VITE_API_URL empty so Vite automatically proxies API requests (/api) to localhost:8000
VITE_API_URL=

# PRODUCTION DEPLOYMENT (Vercel):
# Set this in your Vercel Project Settings -> Environment Variables:
# VITE_API_URL=https://<your-render-backend-url>.onrender.com
